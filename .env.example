YOLO_CONFIG=configs/app.yaml
YOLO_DEVICE=auto
YOLO_STORAGE_DIR=storage
YOLO_REDIS_URL=redis://127.0.0.1:6379/0
YOLO_MLFLOW_TRACKING_URI=http://127.0.0.1:5001
YOLO_API_HOST=127.0.0.1
YOLO_API_PORT=8000
YOLO_LOG_LEVEL=INFO
YOLO_ANNOTATION_MODEL_PATH=storage/pretrained/grounding-dino-tiny
YOLO_CVAT_URL=http://localhost:8080
YOLO_CVAT_USERNAME=
YOLO_CVAT_PASSWORD=
YOLO_LLM_BASE_URL=https://api.deepseek.com
YOLO_LLM_MODEL=deepseek-flash
YOLO_LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
YOLO_LLM_API_KEY=
YOLO_TRAINING_MODEL_DIR=storage/pretrained/yolo26
YOLO_TRAINING_CONFIG_PATH=configs/training.yaml
YOLO_TRAINING_JOB_TIMEOUT=172800
YOLO_EVALUATION_JOB_TIMEOUT=7200
YOLO_MAX_GPU_MEMORY_RATIO=0.90
YOLO_AGENT_CONFIG_PATH=configs/agent.yaml
YOLO_AGENT_STAGNATION_ROUNDS=8
YOLO_AGENT_MINIMUM_IMPROVEMENT=0.001
YOLO_OPTIMIZATION_CONFIG_PATH=configs/optimization.yaml
YOLO_AGENT_POLL_SECONDS=3
YOLO_AGENT_QUEUE_WAIT_SECONDS=300
YOLO_LLM_TIMEOUT_SECONDS=45
