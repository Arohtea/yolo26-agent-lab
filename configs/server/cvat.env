# 原生 CVAT 的统一环境：取自官方 v2.64.0 compose 的 backend-env，服务名改为本机回环地址。
# supervisord 程序与手工 manage.py 命令都经 cvat-run.sh 读取，避免两处配置漂移。
HOME=/home/django
PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 官方镜像把自编译的 FFmpeg 8 放在系统库目录，这里限定只对 CVAT 进程可见
LD_LIBRARY_PATH=/data/cvat/lib
LANG=C.UTF-8
LC_ALL=C.UTF-8
TZ=Etc/UTC
DJANGO_SETTINGS_MODULE=cvat_native_settings
CVAT_POSTGRES_HOST=127.0.0.1
CVAT_REDIS_INMEM_HOST=127.0.0.1
CVAT_REDIS_INMEM_PORT=6380
CVAT_REDIS_INMEM_PASSWORD=
CVAT_REDIS_ONDISK_HOST=127.0.0.1
CVAT_REDIS_ONDISK_PORT=6666
CVAT_LOG_IMPORT_ERRORS=true
CVAT_ALLOW_STATIC_CACHE=no
# ClickHouse/Vector/Grafana 分析组件未部署
CVAT_ANALYTICS=0
ADAPTIVE_AUTO_ANNOTATION=false
ALLOWED_HOSTS=localhost,127.0.0.1
CVAT_HOST=localhost
# 浏览器经 SSH 隧道把本机 8080 转发到服务器 8081
CVAT_BASE_URL=http://localhost:8080
SMOKESCREEN_OPTS=
